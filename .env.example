# Local-only credentials for the isolated development cluster / compose service.
DATABASE_URL=postgresql://family_menu:local-development-only@127.0.0.1:55432/family_menu
TEST_DATABASE_URL=postgresql://family_menu:local-development-only@127.0.0.1:55432/family_menu_test
PORT=3000
HOST=127.0.0.1
# Production migrations should use a separate database-owner credential.
# MIGRATION_DATABASE_URL=
# Browser-facing origin. Development uses the Vite server, which proxies /api to PORT.
APP_ORIGIN=http://127.0.0.1:5173
# Google sign-in through Supabase Auth (see docs/SETUP_AUTH.md). Leave both empty to run
# without sign-in; auth routes then answer 503. Use the PUBLISHABLE key only - the server
# rejects sb_secret_/service_role keys. Put real values in .env, never in Git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# AI recipe drafts (docs/decisions/0006-ai-drafts.md). off (default) | anthropic | deepseek |
# gemini | mock. "mock" is a local deterministic stand-in and is refused on an https origin.
# Put real keys in .env only, never in Git. Anthropic can also use an `ant auth login` profile.
AI_PROVIDER=off
# AI_MODEL=              # default per provider: claude-haiku-4-5, deepseek-flash, gemini-3.1-flash-lite
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# AI_MONTHLY_BUDGET_USD=8.50      # ≈ CAD 12; provider spend cap per UTC month
# AI_HOUSEHOLD_DAILY_LIMIT=5      # drafts per household in any 24 hours
# AI_USER_DAILY_ATTEMPTS=10       # attempts (including failures) per person in any 24 hours
# AI_TIMEOUT_SECONDS=30
# Only for a model missing from the built-in price table (apps/api/src/ai-providers.ts):
# AI_PRICE_INPUT_USD_PER_MTOK=
# AI_PRICE_OUTPUT_USD_PER_MTOK=
