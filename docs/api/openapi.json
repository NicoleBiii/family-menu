      "post": {
        "operationId": "OrdersController_create",
        "parameters": [
          {
            "name": "householdId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required on state-changing requests; returned by GET /api/auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "requestId",
                  "when",
                  "items"
                ],
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "Client-generated per submission; a retry returns the same order."
                  },
                  "when": {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "description": "Household-local meal time. A time skipped by a daylight-saving change is rejected (code nonexistent_time); a repeated one needs disambiguation (code ambiguous_time lists the options).",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "now",
                          "scheduled"
                        ]
                      },
                      "date": {
                        "type": "string",
                        "format": "date",
                        "example": "2026-10-03"
                      },
                      "time": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                        "example": "18:30"
                      },
                      "disambiguation": {
                        "type": "string",
                        "enum": [
                          "earlier",
                          "later"
                        ]
                      }
                    }
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": [
                        "recipeId",
                        "servings"
                      ],
                      "properties": {
                        "recipeId": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "servings": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pending order with a snapshot of each recipe."
          },
          "400": {
            "description": "Invalid input, unknown recipe, or unusable local time."
          },
          "401": {
            "description": "No valid session."
          },
          "404": {
            "description": "Not found, or the caller is not a member of the household."
          },
          "409": {
            "description": "A recipe is archived, or too many pending orders."
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "Meal orders"
        ]
