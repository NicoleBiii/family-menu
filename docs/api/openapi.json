                      "properties": {
                        "name": {
                          "type": "string",
                          "maxLength": 100
                        },
                        "quantity": {
                          "type": "string",
                          "nullable": true,
                          "description": "Exact decimal, at most 3 fraction digits. Omit for \"to taste\" or unknown.",
                          "example": "0.5"
                        },
                        "unit": {
                          "type": "string",
                          "nullable": true,
                          "enum": [
                            "g",
                            "kg",
                            "oz",
                            "lb",
                            "ml",
                            "l",
                            "tsp",
                            "tbsp",
                            "cup",
                            "piece",
                            "clove",
                            "slice",
                            "can",
                            "bunch",
                            "pinch"
                          ]
                        },
                        "form": {
                          "type": "string",
                          "nullable": true,
                          "maxLength": 60,
                          "example": "diced"
                        },
                        "note": {
                          "type": "string",
                          "nullable": true,
                          "maxLength": 200,
                          "example": "to taste"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Recipe replaced; revision incremented."
          },
          "400": {
            "description": "Invalid recipe."
          },
          "401": {
            "description": "No valid session."
