        "operationId": "InvitationsController_preview",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required on state-changing requests; returned by GET /api/auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Household name and expiry for a usable invitation."
          },
          "401": {
            "description": "No valid session."
          },
          "404": {
            "description": "Unknown invitation."
          },
          "410": {
            "description": "Expired, revoked or already used invitation."
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/invitations/accept": {
      "post": {
        "operationId": "InvitationsController_accept",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required on state-changing requests; returned by GET /api/auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
